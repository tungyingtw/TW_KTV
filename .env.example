# Required for admin APIs. Use a long random value in local and production.
ADMIN_TOKEN=replace-with-a-long-random-admin-token

# Optional: override the frontend community/report API endpoint.
# VITE_API_URL=http://localhost:3001

# Optional: enable persistent visitor stats through Upstash Redis REST.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
