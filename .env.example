# Required for admin APIs. Use a long random value in local and production.
ADMIN_TOKEN=replace-with-a-long-random-admin-token

# Optional: override the frontend community/report API endpoint.
# VITE_API_URL=http://localhost:3001

# Optional: enable persistent visitor stats through Upstash Redis REST.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional: override Taiwan visit-region stats Redis key.
# Production defaults to Upstash Redis key ktv:visitRegionStats, so Render Disk is not required.
# VISIT_REGION_STATS_REDIS_KEY=ktv:visitRegionStats

# Required in production for anonymous visit-region dedup/correction hashes.
# Use a long random value and keep it stable after launch.
# VISIT_STATS_HASH_SECRET=replace-with-a-long-random-visit-region-secret

# Optional: automatic visit-region assignment. Defaults to enabled and uses ipwhois.io free endpoint.
# Set to false if the external GeoIP service is unavailable or the daily free quota is not enough.
# VISIT_REGION_AUTO_GEOIP=true
# VISIT_REGION_GEOIP_ENDPOINT=https://ipwho.is
# VISIT_REGION_GEOIP_TIMEOUT_MS=1800
